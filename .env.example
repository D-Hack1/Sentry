IPSEC_SUBNET=10.10.0.0/24
INITIATOR_IP=10.10.0.2
RESPONDER_IP=10.10.0.3
MONITOR_IP=10.10.0.4

INITIATOR_CONTAINER=ipsec-initiator
RESPONDER_CONTAINER=ipsec-responder
MONITOR_CONTAINER=ipsec-monitor
BRIDGE_NAME=br-ipsec

IPSEC_MODE=tunnel
CIPHER=aes256gcm
DH_GROUP=group14
PFS=yes
IPSEC_PSK=change-me

MATRIX_MODES=tunnel,transport
MATRIX_CIPHERS=aes128cbc,aes256cbc,aes128gcm,aes256gcm
MATRIX_DH_GROUPS=group2,group5,group14,group19,group20
MATRIX_PFS=yes,no
TRAFFIC_TYPES=web,voip,video_stream,file_transfer,icmp
EXTRA_SESSIONS=20
SKIP_EXISTING=yes
TRAFFIC_SECONDS=8
SA_TIMEOUT=30
TRAFFIC_PINGS=30
PCAP_DIR=capture/pcaps
CONFIG_DIR=capture/configs

ZOOKEEPER_PORT=2181
KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_PARTITIONS=3
KAFKA_TOPIC_RAW_FEATURES=raw-features
KAFKA_TOPIC_INFERENCE_RESULTS=inference-results
KAFKA_TOPIC_ALERTS=alerts
KAFKA_TOPIC_PIPELINE_METRICS=pipeline-metrics

ES_PORT=9200
ES_HOST=http://localhost:9200
ES_INDEX=ipsec_sessions
ES_JAVA_OPTS="-Xms512m -Xmx512m"
